[submodule "references/fbraz3-dxvk"]
	path = references/fbraz3-dxvk
	url = https://github.com/fbraz3/dxvk.git
	branch = generalsx-macos-v2.6
	# Android applies the ordered local patches from cmake/dx8.cmake during
	# configuration, so a configured checkout is expected to become dirty.
	ignore = dirty
